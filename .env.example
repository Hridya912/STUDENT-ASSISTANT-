# ---------------------------------------------------------------
# Grok Student Assistant — environment variables
#
# Local:  cp .env.example .env.local  and fill in the values,
#         then run `npm run dev` (http://localhost:3000)
# Vercel: Project → Settings → Environment Variables, add the same
#         keys for Production, Preview and Development, then redeploy.
#
# Never commit real keys. .env / .env.local are git-ignored.
# ---------------------------------------------------------------

# Required — your xAI API key from https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Optional — Grok model id (defaults to grok-4.6 if unset)
XAI_MODEL=grok-4.6
